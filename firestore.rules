rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Categories: public read for store catalog, write with validated id
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isValidId(categoryId);
    }

    // Catalog items: public read for visitors, write with validated id
    match /catalog_items/{itemId} {
      allow read: if true;
      allow write: if isValidId(itemId);
    }

    // Store configuration & admin metadata
    match /admin_config/{configId} {
      allow read: if true;
      allow write: if isValidId(configId);
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
